# Copy to .env and fill in. .env is git-ignored.

# LLM provider: groq, anthropic or openai. Not needed when running with --mock.
LLM_PROVIDER=groq
LLM_API_KEY=your_key_here
# Optional: override the model from config/settings.json (e.g. qwen/qwen3.8-27b on Groq)
# LLM_MODEL=

# Fake bank login (fake values only, used by the automated login)
BANK_USERNAME=demo
BANK_PASSWORD=demo123
