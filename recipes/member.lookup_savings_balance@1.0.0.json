{
  "schema_version": "1.0",
  "recipe_id": "member.lookup_savings_balance",
  "name": "LookupMemberSavingsBalance",
  "description": "Look up a bank member by ID and retrieve their savings balance.",
  "version": "1.0.0",
  "status": "draft",
  "needs_review": false,
  "app": {
    "name": "CoreServ Teller",
    "version": "4.2",
    "surface": "web",
    "entry_url": "http://localhost:5050/search"
  },
  "provenance": {
    "recorded_from_run": "20261008T221051Z-2f6a",
    "recorded_at": "2026-10-08T22:11:02.345060Z"
  },
  "inputs": {
    "member_id": {
      "description": "member_id",
      "type": "string",
      "required": true,
      "sensitive": true
    }
  },
  "outputs": {
    "savings_balance": {
      "description": "savings_balance",
      "type": "string",
      "sensitive": true
    }
  },
  "outcomes": {
    "SUCCESS": "The goal was completed and outputs were read.",
    "MEMBER_NOT_FOUND": "No member has this ID.",
    "PERMISSION_DENIED": "The signed-in user may not view this member.",
    "ACCOUNT_ALREADY_EXISTS": "The member already has this account type.",
    "VALIDATION_ERROR": "The app rejected a value on a form."
  },
  "steps": [
    {
      "step": 1,
      "description": "Open the Member Search page.",
      "source": "agent",
      "action": "navigate",
      "url": "/search",
      "risk": "safe",
      "wait_for": {
        "any_of": [
          {
            "text": "Member Search"
          }
        ]
      }
    },
    {
      "step": 2,
      "description": "Enter member ID to search",
      "source": "agent",
      "expect_page": {
        "text_visible": "Member Search"
      },
      "action": "type",
      "target": {
        "strategies": [
          {
            "by": "role",
            "role": "textbox",
            "name": "Member ID",
            "exact": true
          },
          {
            "by": "label",
            "text": "Member ID"
          },
          {
            "by": "css",
            "value": "input[name=\"f1\"]"
          }
        ],
        "why": "role textbox \"Member ID\": semantic, survives layout and markup changes; label \"Member ID\": a real <label> is linked to the field; css input[name=\"f1\"]: depends on markup, last resort. Each was verified to match exactly this element when recorded."
      },
      "value": "{{member_id}}",
      "risk": "safe"
    },
    {
      "step": 3,
      "description": "Search for member ID {member_id}",
      "source": "agent",
      "expect_page": {
        "text_visible": "Member Search"
      },
      "action": "click",
      "target": {
        "strategies": [
          {
            "by": "role",
            "role": "button",
            "name": "Search",
            "exact": true
          },
          {
            "by": "css",
            "value": "input[type=\"submit\"][value=\"Search\"]"
          }
        ],
        "why": "role button \"Search\": semantic, survives layout and markup changes; css input[type=\"submit\"][value=\"Search\"]: depends on markup, last resort. Each was verified to match exactly this element when recorded."
      },
      "risk": "safe",
      "wait_for": {
        "any_of": [
          {
            "text": "Member Detail"
          }
        ]
      }
    },
    {
      "step": 4,
      "description": "Read the member's savings balance",
      "source": "agent",
      "expect_page": {
        "text_visible": "Member Detail"
      },
      "action": "extract",
      "target": {
        "strategies": [
          {
            "by": "near_text",
            "anchor": "Savings Balance:",
            "relation": "right_of"
          },
          {
            "by": "css",
            "value": "td:has-text('Savings Balance:') + td"
          }
        ],
        "why": "next to the stable label \"Savings Balance:\" (the value itself changes per record); css td:has-text('Savings Balance:') + td: depends on markup, last resort. Each was verified to match exactly this element when recorded."
      },
      "save_as": "savings_balance",
      "parse": "currency",
      "risk": "safe"
    }
  ],
  "success_check": {
    "description": "On the final page with every output read.",
    "text_visible": "Member Detail",
    "outputs_present": [
      "savings_balance"
    ]
  },
  "error_handlers": [
    {
      "id": "member_not_found",
      "description": "No member with that ID.",
      "scope": "any_step",
      "when": {
        "text": "No member found."
      },
      "type": "business_outcome",
      "result": "MEMBER_NOT_FOUND"
    },
    {
      "id": "permission_denied",
      "description": "Restricted member.",
      "scope": "any_step",
      "when": {
        "text": "You are not authorized to view this account."
      },
      "type": "business_outcome",
      "result": "PERMISSION_DENIED"
    },
    {
      "id": "account_already_exists",
      "description": "Duplicate account type.",
      "scope": "any_step",
      "when": {
        "text": "This account already exists."
      },
      "type": "business_outcome",
      "result": "ACCOUNT_ALREADY_EXISTS"
    },
    {
      "id": "validation_error",
      "description": "A form value was rejected.",
      "scope": "any_step",
      "when": {
        "text": "Please correct the following:"
      },
      "type": "business_outcome",
      "result": "VALIDATION_ERROR"
    },
    {
      "id": "notice_popup",
      "description": "Maintenance Notice dialog blocks the page.",
      "scope": "any_step",
      "when": {
        "dialog": "Notice"
      },
      "type": "recoverable",
      "fix": {
        "action": "click",
        "target": {
          "strategies": [
            {
              "by": "role",
              "role": "button",
              "name": "OK",
              "exact": true
            }
          ],
          "why": "The dialog's only button."
        }
      },
      "max_attempts": 3
    },
    {
      "id": "slow_page",
      "description": "The page is still loading.",
      "scope": "any_step",
      "when": {
        "wait_timed_out": true
      },
      "type": "recoverable",
      "fix": {
        "action": "wait",
        "seconds": 5.0
      },
      "max_attempts": 3
    },
    {
      "id": "session_expired",
      "description": "Signed out by the app.",
      "scope": "any_step",
      "when": {
        "text": "Session expired"
      },
      "type": "hard_failure",
      "then": "escalate"
    },
    {
      "id": "server_error",
      "description": "The app crashed on this request.",
      "scope": "any_step",
      "when": {
        "text": "Something went wrong."
      },
      "type": "hard_failure",
      "then": "escalate"
    }
  ],
  "default_on_unknown": {
    "type": "hard_failure",
    "then": "escalate"
  }
}
